{
  "name": "studymate",
  "version": "1.0.0",
  "private": true,
  "description": "StudyMate — Your academic life, organized through conversation. Alexa+ MCP Add-on & Web Dashboard.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/mcp-server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:all": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "start": "npm run start --workspace=apps/mcp-server",
    "build": "npm run build --workspaces",
    "db:init": "npm run init --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "db:reset": "npm run reset --workspace=packages/database",
    "typecheck": "npm run typecheck --workspaces"
  },
  "keywords": [
    "alexa-plus",
    "mcp",
    "model-context-protocol",
    "study-assistant",
    "student-productivity"
  ],
  "author": "Alishba Iqbal",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.x"
  }
}
