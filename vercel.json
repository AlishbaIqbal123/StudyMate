{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mcp-server": {
      "root": "apps/mcp-server",
      "entrypoint": "src/index.ts",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "mcp-server",
          "format": "url",
          "env": "MCP_SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
