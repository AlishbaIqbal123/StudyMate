{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/auth/token",
      "destination": "/api/auth"
    },
    {
      "source": "/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/tasks/:id*",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
