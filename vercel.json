{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mcp-server": {
      "root": "apps/mcp-server",
      "framework": "express"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "mcp-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
