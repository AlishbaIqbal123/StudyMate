# StudyMate Environment Configuration (100% Free / Open-Source Stack)

# Port for MCP Server & REST API
PORT=3000

# SQLite Database Location
DATABASE_PATH=./studymate.db

# Single-student MVP default ID
DEFAULT_STUDENT_ID=1

# Web App Port (Vite)
VITE_PORT=5173
VITE_API_URL=http://localhost:3000

# Alexa Skill & Client credentials (from Amazon Developer Console)
ALEXA_SKILL_ID=your_alexa_skill_id_here
ALEXA_CLIENT_ID=your_alexa_client_id_here
ALEXA_CLIENT_SECRET=your_alexa_client_secret_here

# Supabase Cloud Database Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
