# StudyMate Environment Configuration (100% Free / Open-Source Stack)

# Port for MCP Server & REST API
PORT=3000

# SQLite Database Location
DATABASE_PATH=./studymate.db

# Single-student MVP default ID
DEFAULT_STUDENT_ID=1

# Web App Port (Vite)
VITE_PORT=5173
VITE_API_URL=http://localhost:3000

# Optional: Alexa+ Client credentials (for production OAuth linking once approved)
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
